+/**
+ * AIが日本語の文章に中国語（簡体字）の字形を混ぜることがある（例:「執務」が「执务」になる）。
+ * 日本語では使わない字形を、対応する日本語の字に直す。プロンプトでも禁じているが、最後は機械的に直して取りこぼさない。
+ */
+const FROM = "执务实现环经济业营动对应书买产价优个华协单压发变员团园图际况观馆门间开关设计认议论让许评谢诚请说话语读调贷费资质货购车轻转达运过还进远选连适钱银铁错针长页须顾预领题顺项颜风饮饭鱼鸟龙严乐习亲觉举导专术机杂东极构标样检欢气汉满热爱电异疗离种积笔级约纪红细终绍结给络统继续综编网职肤胜脑脸";
+const TO = "執務実現環経済業営動対応書買産価優個華協単圧発変員団園図際況観館門間開関設計認議論譲許評謝誠請説話語読調貸費資質貨購車軽転達運過還進遠選連適錢銀鉄錯針長頁須顧予領題順項顔風飲飯魚鳥龍厳楽習親覚挙導専術機雑東極構標様検歓気漢満熱愛電異療離種積筆級約紀紅細終紹結給絡統継続総編網職膚勝脳顔";
+const SIMPLIFIED_TO_JA = new Map<string, string>([...FROM].map((c, i) => [c, [...TO][i]]));
+
+export function normalizeJapanese(text: string): string {
+  return [...text].map((c) => SIMPLIFIED_TO_JA.get(c) ?? c).join("");
+}
