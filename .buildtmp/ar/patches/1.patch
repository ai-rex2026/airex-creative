diff --git a/Docs/sql/2026-10-13-apply-log.sql b/Docs/sql/2026-10-13-apply-log.sql
new file mode 100644
index 0000000..2ac230e
--- /dev/null
+++ b/Docs/sql/2026-10-13-apply-log.sql
@@ -0,0 +1,18 @@
+-- Googleプロフィールへの反映履歴（追加のみ。既存テーブルは変更しない）
+create table if not exists public.meo_apply_log (
+  id uuid primary key default gen_random_uuid(),
+  store_id text not null references public.stores(id) on delete cascade,
+  key text not null,
+  label text not null,
+  ok boolean not null,
+  error_message text,
+  before_value text,
+  after_value text,
+  created_at timestamptz not null default now()
+);
+create index if not exists meo_apply_log_store_idx on public.meo_apply_log (store_id, created_at desc);
+alter table public.meo_apply_log enable row level security;
+drop policy if exists meo_apply_log_select_own on public.meo_apply_log;
+create policy meo_apply_log_select_own on public.meo_apply_log for select using (public.owns_store(store_id));
+drop policy if exists meo_apply_log_insert_own on public.meo_apply_log;
+create policy meo_apply_log_insert_own on public.meo_apply_log for insert with check (public.owns_store(store_id));
