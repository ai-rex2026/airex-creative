+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { GEMINI_MODEL } from "@/lib/gemini";
+
+/**
+ * Gemini の接続診断（ログインした本人だけ）。どこで断られているかを切り分けるための一時的な道具。
+ * 1) キーでモデル一覧を取れるか  2) 通常の生成  3) Google検索つきの生成  を、モデルごとに短く試す。
+ * キーの値は返さない。1回あたりの費用は1円に満たない。
+ */
+export const maxDuration = 60;
+
+const BASE = "https://generativelanguage.googleapis.com/v1beta";
+
+async function call(url: string, init: RequestInit, limit = 1500) {
+  const t0 = Date.now();
+  try {
+    const res = await fetch(url, { ...init, signal: AbortSignal.timeout(20_000) });
+    const text = await res.text();
+    return { status: res.status, ms: Date.now() - t0, body: text.slice(0, limit) };
+  } catch (e) {
+    return { status: 0, ms: Date.now() - t0, body: String(e instanceof Error ? e.message : e).slice(0, 300) };
+  }
+}
+
+function generate(key: string, model: string, search: boolean) {
+  return call(`${BASE}/models/${model}:generateContent`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "x-goog-api-key": key },
+    body: JSON.stringify({
+      contents: [{ role: "user", parts: [{ text: search ? "東京都港区のWeb広告代理店を1社だけ挙げてください。" : "OKとだけ答えてください。" }] }],
+      ...(search ? { tools: [{ google_search: {} }] } : {}),
+      generationConfig: { maxOutputTokens: 200 },
+    }),
+  });
+}
+
+export async function GET() {
+  const sb = await createClient();
+  const {
+    data: { user },
+  } = await sb.auth.getUser();
+  if (!user || user.is_anonymous) return NextResponse.json({ error: "ログインが必要です" }, { status: 401 });
+
+  const key = process.env.GEMINI_API_KEY;
+  if (!key) return NextResponse.json({ error: "GEMINI_API_KEY が未設定です" }, { status: 200 });
+
+  const models = await call(`${BASE}/models?pageSize=200`, { headers: { "x-goog-api-key": key } }, 300_000);
+  let names: string[] = [];
+  try {
+    names = ((JSON.parse(models.body) as { models?: { name?: string }[] }).models ?? []).map((m) => String(m.name ?? "")).filter((n) => /gemini/.test(n)).slice(0, 40);
+  } catch {
+    /* 一覧が長くて切れた場合は名前の一覧を出さない */
+  }
+
+  const tryModels = [...new Set([GEMINI_MODEL, "gemini-2.5-flash", "gemini-2.5-flash-lite"])];
+  const results: Record<string, unknown> = {};
+  for (const m of tryModels) {
+    results[m] = { plain: await generate(key, m, false), grounded: await generate(key, m, true) };
+  }
+  return NextResponse.json({ configuredModel: GEMINI_MODEL, listModels: { status: models.status, ms: models.ms, names, head: models.status === 200 ? undefined : models.body.slice(0, 800) }, results }, { status: 200 });
+}
