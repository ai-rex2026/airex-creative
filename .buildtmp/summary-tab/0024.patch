+                              {typeof x !== "string" && (
+                                <span className={`tag${x.severity === "重" ? " warn" : ""}`} style={{ marginLeft: 8 }}>
+                                  {x.severity}
+                                </span>
+                              )}
+                            </li>
+                          ))}
+                        </ul>
                       </div>
                     ))}
