+// ── 最新情報の投稿（v4 localPosts）─────────────
+export const POST_SUMMARY_MAX = 1500;
+export type GbpPostAction = "BOOK" | "LEARN_MORE" | "CALL";
+export type GbpPostInput = { summary: string; action?: { type: GbpPostAction; url?: string } | null; imageUrl?: string | null };
+
+/** 投稿に出す本文を組み立てる（LocalPost にタイトル欄は無いので、見出しを先頭行に置く） */
+export function buildPostSummary(title: string, body: string): string {
+  const t = title.trim();
+  const b = body.trim();
+  return t && b ? `${t}\n\n${b}` : t || b;
+}
+
+/** Google に送る本体。API は呼ばない（検証用に切り出してある） */
+export function buildLocalPostBody(p: GbpPostInput) {
+  const summary = p.summary.trim();
+  if (!summary) throw new Error("投稿の本文が空です");
+  if ([...summary].length > POST_SUMMARY_MAX) throw new Error(`投稿は${POST_SUMMARY_MAX}文字までです（見出しと本文の合計）`);
+  const body: Record<string, unknown> = { languageCode: "ja", summary, topicType: "STANDARD" };
+  if (p.action) {
+    if (p.action.type === "CALL") body.callToAction = { actionType: "CALL" };
+    else {
+      const url = (p.action.url ?? "").trim();
+      if (!/^https?:\/\//.test(url)) throw new Error("ボタンのリンク先（WebサイトのURL）が未設定です。ボタンを外すか、店舗のWebサイトを登録してください");
+      body.callToAction = { actionType: p.action.type, url };
+    }
+  }
+  if (p.imageUrl) body.media = [{ mediaFormat: "PHOTO", sourceUrl: p.imageUrl }];
+  return body;
+}
+
+/** 最新情報を公開する。返り値は Google 側の投稿名（accounts/{a}/locations/{l}/localPosts/{p}） */
+export async function createLocalPost(token: string, account: string, location: string, p: GbpPostInput): Promise<string> {
+  if (!/^accounts\/[^/]+$/.test(account) || !/^locations\/[^/]+$/.test(location)) throw new Error("店舗の指定が不正です");
+  const r = await gget<{ name?: string }>(`https://mybusiness.googleapis.com/v4/${account}/${location}/localPosts`, token, "投稿の公開", {
+    method: "POST",
+    body: buildLocalPostBody(p),
+  });
+  if (!r.name) throw new Error("投稿の公開：Googleから投稿の識別子が返りませんでした。Googleマップで公開されたか確認してください");
+  return r.name;
+}
+
+/** 公開済みの投稿を削除する（取り消し） */
+export async function deleteLocalPost(token: string, postName: string): Promise<void> {
+  if (!/^accounts\/[^/]+\/locations\/[^/]+\/localPosts\/[^/]+$/.test(postName)) throw new Error("投稿の指定が不正です");
+  await gget<unknown>(`https://mybusiness.googleapis.com/v4/${postName}`, token, "投稿の削除", { method: "DELETE" });
+}
