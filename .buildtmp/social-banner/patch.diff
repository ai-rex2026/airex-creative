+            {shown.map((f, i) => (
+              <div key={i}>
+                <b
+                  style={{
+                    display: "block",
+                    fontSize: fitOneLine(f.value, colW / (shown.length + 0.4), compact ? 17 * u : 24 * u),
+                    fontWeight: 900,
+                    color: "#fff",
