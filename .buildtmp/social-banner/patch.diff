+      {(textZone === "top" || textZone === "left") && (
+        <div
+          style={{
+            position: "absolute",
+            right: px(compact ? 6 : 12),
+            bottom: px(compact ? 6 : 12),
+            background: "rgba(0,0,0,.55)",
+            color: "#fff",
+            fontWeight: 700,
+            fontSize: fitOneLine(brand.name, w * 0.3, compact ? 11 * u : 15 * u),
+            padding: `${px(compact ? 3 : 5)} ${px(compact ? 8 : 12)}`,
+            borderRadius: px(2),
+            whiteSpace: "nowrap",
+          }}
+        >
+          {brand.name}
+        </div>
+      )}
+    </div>
+  );
+}
